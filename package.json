{
  "name": "iclaw-relay",
  "version": "0.1.0",
  "description": "Tunnel relay for iClaw Remote Access. Byte-forwarding only — never reads payloads; auth is verified end-to-end between browser and local iClaw.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/iClawApp/iclaw-relay",
  "repository": {
    "type": "git",
    "url": "https://github.com/iClawApp/iclaw-relay.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
