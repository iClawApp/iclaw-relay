# ────────────────────────────────────────────────────────────────
# iclaw-relay configuration.
#
# Copy this file to `.env` and adjust. Every value is validated at
# boot time in `src/config.ts` — invalid values fail fast.
# ────────────────────────────────────────────────────────────────

# Node lifecycle mode: development | production | test
NODE_ENV=development

# HTTP listen port.
PORT=4100

# HTTP bind address. Keep localhost in production behind nginx/cloudflared.
HOST=127.0.0.1

# ─── Tunnel routing ──────────────────────────────────────────────
# Base domain under which per-tunnel subdomains are minted.
# A tunnel registered as "silver-fox" is reachable at
#   https://silver-fox.iclaw.digital
BASE_DOMAIN=iclaw.digital

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the public HTTP API
# (the tunnel-data path is origin-checked separately).
# Use "*" for dev (NEVER in production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4100

# ─── Limits ──────────────────────────────────────────────────────
# Per-IP rate limit for tunnel registration (per hour).
RATE_LIMIT_REGISTER_PER_IP_HOUR=20

# Per-IP rate limit for first-access / invite validation (per minute).
RATE_LIMIT_INVITE_PER_IP_MINUTE=60

# ─── Operational ─────────────────────────────────────────────────
# Log tunnel register/connect/disconnect events (subdomain, ip-hash).
# NEVER logs request/response bodies regardless of this flag.
LOG_ACCESS=false

# Trust the first proxy hop's X-Forwarded-For — enable when running
# behind Cloudflare, nginx, etc. so rate-limiting keys off the real IP.
TRUST_PROXY=false
